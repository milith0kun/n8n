# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================

# IP pública del servidor (OBLIGATORIO)
# Ejemplo: SERVER_IP=52.14.254.17
SERVER_IP=tu_ip_publica_aqui

# ===========================================
# CONFIGURACIÓN DE N8N
# ===========================================

# Credenciales de acceso a N8N
N8N_USER=admin
N8N_PASSWORD=tu_password_seguro_aqui

# ===========================================
# CONFIGURACIÓN DE WAHA
# ===========================================

# Credenciales de acceso a WAHA Dashboard
WAHA_USER=admin
WAHA_PASSWORD=tu_password_waha_aqui

# ===========================================
# CONFIGURACIÓN OPCIONAL
# ===========================================

# Timezone (opcional)
TZ=America/Mexico_City

# Base de datos (SQLite por defecto)
DB_TYPE=sqlite

# ===========================================
# INSTRUCCIONES DE USO
# ===========================================

# 1. Copia este archivo como .env:
#    cp .env.example .env
#
# 2. Edita el archivo .env y configura tu SERVER_IP:
#    nano .env
#
# 3. Cambia las contraseñas por defecto por unas seguras
#
# 4. Ejecuta el proyecto:
#    docker-compose up -d
#
# 5. Accede a:
#    - N8N: http://tu_ip_publica/
#    - WAHA Dashboard: http://tu_ip_publica/waha/dashboard
#    - WAHA API Docs: http://tu_ip_publica/waha-docs/